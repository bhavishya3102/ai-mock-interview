# Application
APP_ENV=development
PORT=8080
LOG_LEVEL=debug

# CORS — comma-separated origin list
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Postgres (Neon). DATABASE_URL is the pooled connection (used by the app);
# DATABASE_URL_DIRECT is the non-pooled direct connection (used by golang-migrate
# because PgBouncer transaction-mode breaks advisory locks).
# Get yours at https://console.neon.tech — copy the "pooled" connection string.
DATABASE_URL=postgresql://neondb_owner:npg_EhQLVd6nYw1p@ep-twilight-fire-aqdpspoi.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://neondb_owner:npg_EhQLVd6nYw1p@ep-twilight-fire-aqdpspoi.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clerk (server-side only — never expose CLERK_SECRET_KEY to the browser)
# Get from https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Google Gemini (server-side only)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
