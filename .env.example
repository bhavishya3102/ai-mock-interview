# Root .env.example — POINTER ONLY.
#
# This monorepo uses per-app environment files. There is no root .env;
# this file exists so a reader can see the variable surface in one place
# without hunting through subdirectories.
#
# Concrete templates:
#   - backend/.env.example   → copy to backend/.env
#   - frontend/.env.example  → copy to frontend/.env
#
# Quick start:
#   cp backend/.env.example  backend/.env
#   cp frontend/.env.example frontend/.env
#   # then fill in real values from Neon, Clerk, and Google AI Studio
#
# All real .env files are gitignored. Only .env.example files are committed.

# -----------------------------------------------------------------------------
# backend/.env  (Go API — loaded via godotenv when APP_ENV != production)
# -----------------------------------------------------------------------------
# DATABASE_URL=             # Neon pooled connection string (sslmode=require)
# DATABASE_URL_DIRECT=      # Neon non-pooled connection string (for migrations)
# CLERK_SECRET_KEY=         # sk_test_... from Clerk dashboard
# CLERK_PUBLISHABLE_KEY=    # pk_test_... from Clerk dashboard
# GEMINI_API_KEY=           # from Google AI Studio (https://aistudio.google.com/apikey)
# PORT=8080
# CORS_ALLOWED_ORIGIN=http://localhost:5173
# APP_ENV=development
# LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# frontend/.env  (Vite — only VITE_-prefixed vars reach the client bundle)
# -----------------------------------------------------------------------------
# VITE_CLERK_PUBLISHABLE_KEY=   # same pk_test_... as backend's CLERK_PUBLISHABLE_KEY
# VITE_API_BASE_URL=/api/v1     # Vite proxies /api -> http://localhost:8080 in dev
